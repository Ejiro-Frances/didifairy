# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real secrets.
# See docs/SETUP.md for how to obtain each value.

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Sentry ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── WhatsApp Cloud API ──────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=
# Public WhatsApp number shown to customers for click-to-chat (intl format)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Admin ───────────────────────────────────────────────────
# The email that is treated as the store admin (gates /admin).
ADMIN_EMAIL=admin@didifairy.com

# ── Bank transfer (shown to customers at checkout) ──────────
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# ── App ─────────────────────────────────────────────────────
# Base URL used for Paystack callbacks/webhooks (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
